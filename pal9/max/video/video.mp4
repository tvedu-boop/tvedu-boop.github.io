<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Video Player</title>

<style>
html,body{
    margin:0;
    padding:0;
    background:#000;
    width:100%;
    height:100%;
}

video{
    width:100%;
    height:100vh;
    object-fit:contain;
}
</style>
</head>

<body>

<video controls autoplay playsinline>
    <source src="video.mp4" type="video/mp4">
    Your browser does not support HTML5 video.
</video>

</body>
</html>
